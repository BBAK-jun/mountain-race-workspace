{
  "name": "mountain-race-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24.0.0 <26",
    "pnpm": ">=10.25.0"
  },
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:web": "pnpm --filter @mountain-race/web dev",
    "dev:api": "pnpm --filter @mountain-race/api dev",
    "dev:all": "pnpm --parallel --stream --filter @mountain-race/api --filter @mountain-race/web dev",
    "docs:sync": "node --experimental-strip-types scripts/docs-harness/index.mts",
    "docs:check": "node --experimental-strip-types scripts/docs-harness/index.mts --check",
    "docs:audit": "node --experimental-strip-types scripts/docs-harness/index.mts --audit",
    "test:codex-hooks": "node --test --experimental-strip-types scripts/codex-hooks/*.test.mts",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @mountain-race/web build",
    "build:api": "pnpm --filter @mountain-race/api build",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "typecheck": "pnpm typecheck:scripts && pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm docs:check && pnpm docs:audit && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
